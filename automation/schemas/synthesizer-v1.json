{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/synthesizer-v1.json",
  "title": "AutoDev synthesizer output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_markdown", "ux"],
  "properties": {
    "handoff_markdown": {
      "type": "string",
      "minLength": 1
    },
    "ux": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints_addressed", "open_questions"],
      "properties": {
        "constraints_addressed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_kind", "source_id", "impact"],
            "properties": {
              "source_kind": {
                "type": "string",
                "enum": ["journey", "screen", "state", "contract", "principle"]
              },
              "source_id": {"type": "string", "minLength": 1},
              "impact": {"type": "string", "minLength": 1}
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
