# Copy this file to ~/automation/state/PROJECT.env and replace placeholders.
REPO_PATH="~/repos/PROJECT"
GITHUB_OWNER="OWNER"
GITHUB_REPO="PROJECT"
BASE_BRANCH="main"
REMOTE_NAME="origin"
AUTOMATION_ROOT="~/automation"
PROMPT_DIR="~/automation/prompts"
PROFILES_PATH="~/automation/codex-profiles.json"
# Optional isolated gh auth config. Leave blank to use existing gh auth, including the invoking user under sudo.
GH_CONFIG_DIR=""
PROFILES=""
LOCAL_CHECK=""
STACK_CONTEXT=""
MAX_REPAIR_ATTEMPTS="3"
LOCAL_CHECK_TIMEOUT="45m"
CI_TIMEOUT="45m"
CODEX_TIMEOUT="2h"

# Optional version-2 provider role profile and safe preflight output.
PROVIDER_PROFILE=""
PROVIDER_PREFLIGHT_OUT=".autodev-run/provider-preflight.json"

# Semantic verification is enabled when the provider profile configures a verifier role.
# Set DISABLE_SEMANTIC_VERIFICATION=1 to preserve the legacy PASS/FAIL workflow.
DISABLE_SEMANTIC_VERIFICATION="0"
MAX_SEMANTIC_REPAIR_ATTEMPTS="1"

# Set only the credentials required by the selected profile. Never commit real values.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Legacy provider/model/command overrides remain supported and are resolved by Python.
PLANNER_PROVIDER=""
PLANNER_MODEL=""
PLANNER_AGENT_COMMAND=""
AGENT_PROVIDER=""
AGENT_MODEL=""
AGENT_COMMAND="codex exec"

# Optional KeePassXC token loading. Leave blank to use existing gh auth or GH_TOKEN.
KEEPASS_DB=""
KEEPASS_KEY_FILE=""
KEEPASS_ENTRY_PATH=""
KEEPASS_NO_PASSWORD="1"
