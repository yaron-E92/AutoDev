{
  "$schema": "https://opencode.ai/config.json",

  // Example only: replace every placeholder with a currently available model ID.
  // Credentials stay in normal OpenCode/provider configuration, not in this file.
  "agent": {
    "autodev-coordinator": {
      "model": "groq/<coordinator-model>"
    },
    "autodev-reader": {
      "model": "groq/<reader-model>"
    },
    "autodev-synthesizer": {
      "model": "groq/<synthesizer-model>"
    },
    "autodev-planner": {
      "model": "groq/<planner-model>"
    },
    "autodev-implementer": {
      "model": "openrouter/<implementation-model>"
    },
    "autodev-fixer": {
      "model": "openrouter/<fixer-model>"
    },
    "autodev-verifier": {
      "model": "groq/<verifier-model>"
    }
  }
}
